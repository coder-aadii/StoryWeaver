# Copy to .env and fill in only what you use. Every provider is optional.

# --- Database (docker compose maps Postgres to host port 5433 to avoid clashing with a local install)
POSTGRES_USER=storyweaver
POSTGRES_PASSWORD=storyweaver
POSTGRES_DB=storyweaver
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://storyweaver:storyweaver@localhost:5433/storyweaver

# --- Storage (unset => <repo>/data; relative paths resolve against the repo root)
# STORAGE_ROOT=
# MAX_UPLOAD_BYTES=536870912

# --- LLM providers
OLLAMA_BASE_URL=http://localhost:11434
GOOGLE_AI_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# --- Model selection (no model names are hard-coded in the code)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=
ANALYSIS_LLM_MODEL=
STORY_LLM_MODEL=
SCRIPT_LLM_MODEL=
CLASSIFICATION_LLM_MODEL=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=

# --- Application
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]

# --- Optional services
COMFYUI_BASE_URL=
TEMPORAL_ADDRESS=

# --- Web: NEXT_PUBLIC_API_URL is read from apps/web/.env.local, not from this file (see apps/web/.env.example)
